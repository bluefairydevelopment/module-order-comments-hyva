# Gate 1 static analysis for module-order-comments-hyva.
# Run from the package root, with MAGENTO_ROOT set:
#   MAGENTO_ROOT=/path/to/magento /path/to/magento/vendor/bin/phpstan analyse -c phpstan.neon.dist
#
# Three rules make the result meaningful: the root must have the package installed
# and compiled, each root in a comparison needs its own TMPDIR, and the run must
# happen at BOTH ends of the declared version range.
parameters:
    # composer.json requires "php": "~8.3.0 || ~8.4.0 || ~8.5.0", and a constraint is a claim about
    # every version it admits - analyse at the LOWER bound. Raise this only
    # together with the composer constraint; they are one claim in two files.
    phpVersion: 80300
    level: 5
    paths:
        - Observer
        - registration.php
    excludePaths:
        - */Test/*
        - */node_modules/*
    bootstrapFiles:
        - Test/bootstrap.php
    treatPhpDocTypesAsCertain: false
