<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!--
        Registers view/frontend/tailwind with Hyvä's config generator so the theme's
        Tailwind build reaches this module's templates. Without it every utility class
        that appears only here is absent from the compiled CSS and the element renders
        as though the class were never written.
    -->
    <event name="hyva_config_generate_before">
        <observer name="BlueFairy_OrderCommentsHyva" instance="BlueFairy\OrderCommentsHyva\Observer\RegisterModuleForHyvaConfig"/>
    </event>
</config>
