#!/usr/bin/env bash
#
# pre-push for bluefairy/module-order-comments-hyva.
#
# TWO JOBS, and both of them can refuse a push:
#
#   1. A BRANCH push that brings new commits must carry a CHANGELOG.md change.
#      Tags are skipped here: a tag names a commit already on the branch, so the
#      "new commits" query is empty and this rule would reject every tag push.
#
#   2. A TAG push must pass this package's own gates FIRST, and every tag pushed
#      must name HEAD with a clean working tree - the gates read the working tree,
#      and a tag on any other commit would publish bytes nobody tested.
#      Composer validate, phpunit, phpcs and phpstan run against the tree being tagged
#      and ANY non-zero exit refuses the push. Exit codes are read, never output.
#
# INSTALL: this file is tracked. One line per clone, once:
#
#     git config core.hooksPath .githooks
#
# Test/Unit/Package/TheReleaseGateIsArmedTest refuses the suite until that is
# done, so a clone cannot forget.
#
# THE TOOLS COME FROM MAGENTO_ROOT. This package has no vendor/ of its own (unlike
# module-order-comments, which pins its tools at its repository root), and
# Test/bootstrap.php needs a Magento install with compiled DI anyway. So the hook
# refuses a tag push without MAGENTO_ROOT rather than run the gates against
# nothing: a phpstan run over an uncompiled root reports 0 for the wrong reason
# and a release gate must say which
# install it ran against.
#
# phpcs GETS NO PATH ARGUMENT: phpcs.xml.dist names `.` itself and excludes Test/,
# docs/ and node_modules/. Warnings are part of the gate - the ruleset excludes only
# formatting sniffs, so there is nothing to mute.
#
# NOT A SERVER-SIDE CONTROL. `git push --no-verify`, an unwired clone, or a tag made in
# GitHub's UI all bypass it. It stops the
# honest mistake: tagging over a red suite without noticing.
#
# CONTROL: re-run a tag push over a deliberately red test whenever this file changes; a
# release gate never seen to refuse is an untested instrument.

set -u

z40=0000000000000000000000000000000000000000
has_commits=false
changelog_updated=false
tags_pushed=""
tag_shas=""

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$z40" ] && continue

    case "$local_ref" in
        refs/tags/*)
            # EVERY tag, not the last one read: `git push --tags` can carry several.
            tags_pushed="${tags_pushed} ${local_ref#refs/tags/}"
            tag_shas="${tag_shas} ${local_sha}"
            continue
            ;;
    esac

    # A remote sha this clone has never fetched cannot be diffed against; treat it as a
    # first push and compute the new commits instead.
    if [ "$remote_sha" != "$z40" ] && ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
        remote_sha=$z40
    fi

    if [ "$remote_sha" = "$z40" ]; then
        # FAIL CLOSED: a git command that errors prints nothing, and nothing reads exactly like
        # "no new commits" - which would skip this rule instead of enforcing it.
        if ! new_commits=$(git log --format="%H" "$local_sha" --not --remotes); then
            echo "  Push refused: could not list the commits being pushed (git log failed)." >&2
            exit 1
        fi
        [ -z "$new_commits" ] && continue
        # ONE diff-tree PER COMMIT: given several commits at once, diff-tree compares them
        # against each other and printed nothing for a multi-commit push (module-order-comments).
        changed=""
        for c in $new_commits; do
            if ! files=$(git diff-tree --no-commit-id -r --root --name-only "$c"); then
                echo "  Push refused: could not read the files changed by $c (git diff-tree failed)." >&2
                exit 1
            fi
            changed="${changed}${files}
"
        done
    else
        if ! changed=$(git diff --name-only "$remote_sha" "$local_sha"); then
            echo "  Push refused: could not diff $remote_sha..$local_sha (git diff failed)." >&2
            exit 1
        fi
        [ -z "$changed" ] && continue
    fi

    has_commits=true

    if echo "$changed" | grep -qx 'CHANGELOG.md'; then
        changelog_updated=true
    fi
done

if $has_commits && ! $changelog_updated; then
    echo "" >&2
    echo "  Push rejected: CHANGELOG.md has not been updated." >&2
    echo "  Add an entry to CHANGELOG.md and commit it before pushing." >&2
    echo "" >&2
    exit 1
fi

if [ -n "$tags_pushed" ]; then
    root="$(git rev-parse --show-toplevel)"
    cd "$root" || exit 1

    head=$(git rev-parse HEAD)
    for sha in $tag_shas; do
        target=$(git rev-parse "${sha}^{commit}" 2>/dev/null)
        if [ "$target" != "$head" ]; then
            echo "" >&2
            echo "  Tag push refused: a tag points at ${target:-an unknown object}, but HEAD is ${head}." >&2
            echo "  The gates measure the working tree. Check out the commit you are tagging and retry." >&2
            echo "" >&2
            exit 1
        fi
    done
    if [ -n "$(git status --porcelain)" ]; then
        echo "" >&2
        echo "  Tag push refused: the working tree has uncommitted or untracked changes." >&2
        echo "  The gates would measure them and the tag would not contain them. Commit or stash, then retry." >&2
        echo "" >&2
        exit 1
    fi

    if [ -z "${MAGENTO_ROOT:-}" ] || [ ! -x "${MAGENTO_ROOT}/vendor/bin/phpunit" ]; then
        echo "" >&2
        echo "  Tag push refused: MAGENTO_ROOT is not set to a Magento install with vendor/bin/phpunit." >&2
        echo "  The gates have to run against the tree being tagged, and say which install they" >&2
        echo "  measured it against. Export MAGENTO_ROOT and retry." >&2
        echo "" >&2
        exit 1
    fi

    # Exactly one tag, and it must be a version: the package is installed into the gate's Magento at
    # that version, so a second tag would be gated as if it were the first.
    tag_version=""
    set -- $tags_pushed
    if [ "$#" -eq 1 ]; then
        v="${1#v}"
        if echo "$v" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9.]+)?$'; then
            tag_version="$v"
        fi
    fi
    if [ -z "$tag_version" ]; then
        echo "" >&2
        echo "  Tag push refused: push exactly one tag, and make it a version (x.y.z); got:${tags_pushed}." >&2
        echo "  The package is installed into the gate's Magento at the tag's version." >&2
        echo "" >&2
        exit 1
    fi

    echo "pre-push: running the release gates for tag(s)${tags_pushed} against a copy of ${MAGENTO_ROOT} with this tree installed" >&2

    # ONE PRIVATE DIRECTORY PER RUN, for the logs and phpstan's cache alike. Fixed names under /tmp
    # were predictable - another local user could plant a symlink and have a gate's output truncate
    # a file of ours.
    run_dir=$(mktemp -d "${TMPDIR:-/tmp}/order-comments-hyva-pre-push.XXXXXX") || exit 1
    gate_root="$run_dir/gate-root"
    stan_tmp="$run_dir/phpstan"
    mkdir "$stan_tmp" || exit 1
    # The gate's Magento copy holds a full vendor/ and the source install's auth.json. It is removed
    # on every way out of the hook (failure, Ctrl-C, success); only the logs stay on a refusal,
    # because the refusal names them.
    trap 'rm -rf "${run_dir:?}/gate-root"' EXIT
    trap 'exit 130' INT TERM HUP

    gate() {
        local name="$1"; shift
        "$@" >"$run_dir/$name.log" 2>&1
        local status=$?
        if [ "$status" -ne 0 ]; then
            echo "" >&2
            echo "  Tag push refused: ${name} exited ${status}. Log: $run_dir/${name}.log" >&2
            echo "  A tag is a release. Fix it, or do not tag it." >&2
            echo "" >&2
            exit "$status"
        fi
        echo "pre-push: ${name} exit 0" >&2
    }

    # The install the gates run against: MAGENTO_ROOT's copy with this tree's package in it.
    prepare_gate_root() {
        local src="$1" dest="$2" ver="$3" others rc rel line
        mkdir -p "$dest" || return 1
        rsync -a --delete --exclude '/generated/' --exclude '/var/' --exclude '/pub/static/' \
            --exclude '/dev/tests/integration/tmp/' "$src/" "$dest/" || return 1
        mkdir -p "$dest/generated" "$dest/var" "$dest/pub/static" || return 1
        rm -f "$dest/app/etc/env.php"
        [ ! -e "$dest/app/etc/env.php" ] || return 1
        cd "$dest" || return 1
        others=$(php -r 'foreach (array_keys(json_decode(file_get_contents("composer.json"), true)["require"] ?? []) as $k) { if (strpos($k, "bluefairy/") === 0) { echo $k, " "; } }') || return 1
        if [ -n "$others" ]; then
            # shellcheck disable=SC2086
            composer remove --no-interaction $others || return 1
        fi
        # The module this one extends is a separate repository: build it from its latest tag (not from
        # whatever is checked out there) and install it beside this tree. GATE_DEPS_ROOT is the directory
        # holding the sibling checkouts; it defaults to the directory this repository sits in.
        dep_src="${GATE_DEPS_ROOT:-$(dirname "$root")}/module-order-comments"
        dep_tag=$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE git -C "$dep_src" tag -l 'v[0-9]*' --sort=-v:refname 2>/dev/null | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | head -1); [ -n "$dep_tag" ] || { echo "MISSING DEP: no release tag in $dep_src (set GATE_DEPS_ROOT to the directory holding the sibling checkouts)"; return 1; }
        dep_dir="$run_dir/deps/module-order-comments"
        mkdir -p "$dep_dir" || return 1
        env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE git -C "$dep_src" archive -o "$dep_dir.tar" "$dep_tag" || return 1
        tar -x -f "$dep_dir.tar" -C "$dep_dir" || return 1
        dep_mod=$(sed -n 's/.*<module name="\([A-Za-z_]*\)".*/\1/p' "$dep_dir/etc/module.xml" | head -1)
        [ -n "$dep_mod" ] || { echo "MISSING DEP: no module name in $dep_dir/etc/module.xml"; return 1; }
        composer config "repositories.module-order-comments" \
            "{\"type\":\"path\",\"url\":\"$dep_dir\",\"options\":{\"symlink\":false,\"versions\":{\"bluefairy/module-order-comments\":\"${dep_tag#v}\"}}}" || return 1
        composer config "repositories.module-order-comments-hyva" \
            "{\"type\":\"path\",\"url\":\"$root\",\"options\":{\"symlink\":false,\"versions\":{\"bluefairy/module-order-comments-hyva\":\"$ver\"}}}" || return 1
        composer require --no-interaction "bluefairy/module-order-comments:${dep_tag#v}" "bluefairy/module-order-comments-hyva:$ver" || return 1
        php bin/magento module:enable "$dep_mod" BlueFairy_OrderCommentsHyva || return 1
        php -d memory_limit=6G bin/magento setup:di:compile || return 1
        # The proof that the compile saw this module: it is enabled in the copy's module list.
        grep -q "'BlueFairy_OrderCommentsHyva' => 1" app/etc/config.php || {
            echo "BlueFairy_OrderCommentsHyva is not enabled in the gate root's app/etc/config.php"
            return 1
        }
        # And that what was installed is this tree's bytes, not a cached or older copy.
        [ -d "$dest/vendor/bluefairy/module-order-comments-hyva" ] || { echo "MISSING bluefairy/module-order-comments-hyva: not installed at $dest/vendor/bluefairy/module-order-comments-hyva"; return 1; }
        diff -rq -x Test -x .git -x vendor -x node_modules "$root" "$dest/vendor/bluefairy/module-order-comments-hyva" > "$run_dir/diff.txt" 2>&1
        rc=$?
        [ "$rc" -le 1 ] || { echo "diff of bluefairy/module-order-comments-hyva failed (status $rc)"; return 1; }
        if grep -q '^Files .* differ$' "$run_dir/diff.txt" || grep -q -v -e '^Only in ' -e '^Files .* differ$' "$run_dir/diff.txt"; then
            echo "STALE bluefairy/module-order-comments-hyva: the installed copy differs from this tree"
            return 1
        fi
        while IFS= read -r line; do
            case "$line" in
                "Only in $dest/vendor/bluefairy/module-order-comments-hyva"*)
                    echo "STALE bluefairy/module-order-comments-hyva: $line"; return 1 ;;
                "Only in $root"*)
                    rel="${line#Only in $root}"; rel="${rel#/}"; case "$rel" in ": "*) rel="${rel#: }" ;; *) rel="${rel/: //}" ;; esac
                    # A directory rule ("docs-build/ export-ignore") matches only with the trailing slash.
                    [ ! -d "$root/$rel" ] || rel="$rel/"
                    [ "$(git -C "$root" check-attr export-ignore -- "$rel" | sed 's/.*: //')" = "set" ] || git -C "$root" check-ignore -q -- "$rel" || { echo "STALE bluefairy/module-order-comments-hyva: $rel is in the tree but not in the install"; return 1; }
                    ;;
            esac
        done < "$run_dir/diff.txt"
        cd "$root" || return 1
    }
    gate prepare-gate-root prepare_gate_root "$MAGENTO_ROOT" "$gate_root" "$tag_version"

    gate composer-validate composer validate --no-check-publish --quiet
    gate phpunit env MAGENTO_ROOT="$gate_root" "$gate_root/vendor/bin/phpunit" -c phpunit.xml.dist
    gate phpcs "$gate_root/vendor/bin/phpcs" --standard=phpcs.xml.dist -q
    gate phpstan env MAGENTO_ROOT="$gate_root" TMPDIR="$stan_tmp" "$gate_root/vendor/bin/phpstan" analyse -c phpstan.neon.dist --no-progress --memory-limit=2G

    rm -rf "$run_dir"
fi

exit 0
